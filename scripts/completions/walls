#compdef walls

_walls() {
    local state

    _arguments \
        '1:command:->command' \
        '*:args:->args'

    case "$state" in
        command)
            local commands=(
                'pick:Thumbnail grid picker'
                'set:Set a wallpaper'
                'restore:Start hyprpaper with the last wallpaper'
                'current:Print the current wallpaper path'
            )
            _describe 'command' commands
            ;;
        args)
            case "$words[2]" in
                set)
                    local dir="${WALLS_DIR:-$HOME/Pictures/walls}"
                    _alternative \
                        "walls:wallpaper:_files -W ${(q)dir}" \
                        'files:image file:_files -g "*.(png|jpg|jpeg|webp)(-.)"'
                    ;;
            esac
            ;;
    esac
}

_walls "$@"
